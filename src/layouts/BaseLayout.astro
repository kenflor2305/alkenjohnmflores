---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

const { title = "My Portfolio" } = Astro.props;
---

<!doctype html>
<html lang="en" class="dark">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>{title}</title>
    </head>

    <body
        id="top"
        class="bg-white text-center text-slate-900 dark:bg-slate-900 dark:text-white"
    >
        <!-- Header -->
        <Header />

        <!-- Page Content -->
        <main class="min-h-[60vh]">
            <slot />
        </main>

        <!-- Footer -->
        <Footer />

        <!-- GSAP -->
        <script
            is:inline
            src="https://cdn.jsdelivr.net/npm/gsap@3.15/dist/gsap.min.js"
        ></script>
        <script
            is:inline
            src="https://cdn.jsdelivr.net/npm/gsap@3.15/dist/ScrollTrigger.min.js"
        ></script>

        <script is:inline>
            window.addEventListener("load", () => {
                if (!window.gsap || !window.ScrollTrigger) return;

                gsap.registerPlugin(ScrollTrigger);

                // Intro Animation
                const tl = gsap.timeline({
                    defaults: {
                        duration: 0.8,
                        ease: "power2.out",
                    },
                });

                tl.from("#heroTitle", {
                    y: -40,
                    opacity: 0,
                });

                // Replay Intro
                document
                    .querySelector("#replayBtn")
                    ?.addEventListener("click", () => {
                        tl.restart();
                    });

                // Dark Mode
                document
                    .querySelector("#darkModeToggle")
                    ?.addEventListener("click", () => {
                        document.documentElement.classList.toggle("dark");
                    });
            });
        </script>
    </body>
</html>
