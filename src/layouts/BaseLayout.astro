---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

interface Props {
    title?: string;
}

const { title = "My Portfolio" } = Astro.props;
---

<!doctype html>
<html lang="en" class="dark">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>{title}</title>
    </head>

    <body
        id="top"
        class="bg-white text-center text-slate-900 dark:bg-slate-900 dark:text-white"
    >
        <!-- Header -->
        <Header />

        <!-- Page Content -->
        <main class="min-h-[60vh]">
            <slot />
        </main>

        <!-- Footer -->
        <Footer />

        <!-- GSAP -->
        <script
            is:inline
            src="https://cdn.jsdelivr.net/npm/gsap@3.15/dist/gsap.min.js"
        ></script>
        <script
            is:inline
            src="https://cdn.jsdelivr.net/npm/gsap@3.15/dist/ScrollTrigger.min.js"
        ></script>

        <script>
            import "../scripts/animations.js";
        </script>
    </body>
</html>
