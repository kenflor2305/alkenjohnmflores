---
import Hero from "./sections/Hero.astro";
import Projects from "./sections/Project.astro";
import About from "./sections/About.astro";
import Contact from "./sections/Contact.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Alken Flor | Portfolio">
    <div
        id="progressBar"
        class="fixed left-0 top-0 z-50 h-1 w-full origin-left bg-gradient-to-r from-blue-500 to-purple-600"
        aria-hidden="true"
    ></div>

    <div class="mx-auto flex max-w-6xl flex-col gap-24 px-6 py-16 md:px-12">
        <Hero />
        <Projects />
        <About />
        <Contact />
    </div>
</BaseLayout>
